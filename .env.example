# Copiar a .env y ajustar. Todo es opcional: la app arranca sin ninguna
# variable usando SQLite local y el asistente extractivo.

# Base de datos (URL async de SQLAlchemy). Default: sqlite+aiosqlite:///./data/app.db
# En Docker se usa sqlite+aiosqlite:////data/app.db
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# Proveedor de IA externo. Si OPENAI_API_KEY está vacío se usa el modo
# extractivo local. OPENAI_BASE_URL permite apuntar a cualquier endpoint
# compatible con la API de OpenAI (ej. Ollama: http://localhost:11434/v1).
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_MODEL=gpt-4o-mini

# Retrieval: cantidad de chunks de contexto y umbral mínimo de similitud
RETRIEVAL_TOP_K=4
MIN_SIMILARITY=0.08

# Tamaño máximo de archivo a subir, en bytes (default 5 MB)
MAX_UPLOAD_BYTES=5242880

# Orígenes permitidos por CORS, separados por coma
CORS_ORIGINS=*
